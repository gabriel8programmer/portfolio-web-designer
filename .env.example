# Database Configuration
# Desenvolvimento Local: SQLite tradicional
DATABASE_URL="file:./dev.db"

# Produção (Turso / LibSQL):
# Configure estas variáveis na Vercel / ambiente de produção:
TURSO_DATABASE_URL="libsql://seu-banco-org.turso.io"
TURSO_AUTH_TOKEN="seu-token-de-autenticacao-do-turso"


# Admin Authentication
SUPER_ADMIN_EMAIL="admin@gbsoftwaresolutions.com.br"
# NOTA: O Next.js (@next/env) expande o símbolo $ a menos que seja escapado com barra invertida \:
SUPER_ADMIN_PASSWORD_HASH="\$2b\$10\$EJb2x9Z4AM9KHJOiIMufIugXTplmWwdXiBMs1LNE95LqlCgWfc5q6"
# Alternativamente, em produção você pode definir SUPER_ADMIN_PASSWORD diretamente se preferir.
ADMIN_SESSION_SECRET="change-this-to-a-secure-random-32-char-string-in-production"

# Commercial & Contact Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Olá! Vi seus projetos no site e gostaria de um orçamento para a minha empresa."
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/gbsoftwaresolutions"

# Email Notifications
# O sistema suporta tanto a API REST da SendPulse (ID + Secret) quanto o SMTP (Nodemailer).

# Opção 1: SendPulse REST API (Recomendado se você possui API ID / Secret)
# Obtenha em: SendPulse > Configurações da Conta > API > ID e Chave Secreta
SENDPULSE_API_USER_ID=""
SENDPULSE_API_SECRET=""
SENDPULSE_FROM_EMAIL="contato@gbsoftwaresolutions.com.br"
SENDPULSE_FROM_NAME="GB Software Solutions"

# Opção 2: SendPulse SMTP via Nodemailer
# Obtenha em: SendPulse > Serviço SMTP > Configurações de SMTP
SMTP_HOST="smtp-pulse.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="contato@gbsoftwaresolutions.com.br"

# E-mail que receberá os alertas quando um visitante preencher o formulário
CONTACT_NOTIFICATION_EMAIL="admin@gbsoftwaresolutions.com.br"

